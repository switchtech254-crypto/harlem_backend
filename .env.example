DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# sqlite by default; use Postgres in production:
# DATABASE_URL=postgres://harlem:harlem@db:5432/harlem
# SMTP (console backend is used when EMAIL_HOST is empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Harlem Store <no-reply@harlemstore.co.ke>
STORE_NOTIFICATION_EMAILS=orders@harlemstore.co.ke
LOW_STOCK_THRESHOLD=5
SECURE_SSL_REDIRECT=false
